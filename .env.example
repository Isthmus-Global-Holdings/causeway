# Copy to .dev.vars for `wrangler dev`.
# `npm run dev` also loads .dev.vars.test on top of this file: the test CRM's
# HUBSPOT_ACCESS_TOKEN and HUBSPOT_PORTAL_ID (README → Test CRM). This one's
# HubSpot token is only used by `npm run dev:live`.
# Static token for the app install in the HubSpot account (hs project open → app → Distribution).
HUBSPOT_ACCESS_TOKEN=
# Skips the Cloudflare Access check, but only for requests to localhost —
# the middleware ignores it on any other host.
DEV_BYPASS_ACCESS=true
